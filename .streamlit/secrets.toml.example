# Ejemplo de configuración de secrets para Streamlit Cloud
# Copia este archivo en Streamlit Cloud → Settings → Secrets

# URL de tu API en Render (después de desplegar)
API_URL = "https://eda-dashboard-api.onrender.com"

# Opcional: Credenciales de base de datos
# [database]
# host = "xxx.xxx.xxx.xxx"
# port = 5432
# user = "admin"
# password = "secreto123"
